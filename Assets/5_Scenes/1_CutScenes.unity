MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 765183856}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 89f6510949c36bb449113d7ee7c6d3bd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CutSceneManager
  backgroundImage: {fileID: 1073522177}
  narrationText: {fileID: 620810359}
  frames:
  - image: {fileID: 21300000, guid: 8e7107f3ff0c46d4194defcc661231b4, type: 3}
    narration: " \"\uBAA8\uB4E0 \uC774\uAC00 \uC0C9\uCC44\uC758 \uCD95\uBCF5\uC744
      \uBC1B\uB294 \uB098\uB77C, \uD314\uB808\uD2F0\uC544. \uD558\uC9C0\uB9CC \uB098\uC5D0\uAC8C
      \uD5C8\uB77D\uB41C \uB9C8\uB825\uC740 '0'\uC774\uC5C8\uB2E4.\""
  - image: {fileID: 21300000, guid: f77b9bf794aff1e4b8bd98770ec7f98c, type: 3}
    narration: " \"\uC0DD\uC77C\uB0A0 \uB2E4\uC2DC \uB9CC\uB098\uC790\uAFB8\uB098.
      \uB108\uB97C \uC704\uD55C \uC544\uC8FC \uD2B9\uBCC4\uD55C \uC120\uBB3C\uC744
      \uC900\uBE44\uD574 \uB450\uC5C8\uB2E8\uB2E4.\""
  - image: {fileID: 21300000, guid: 22e77ab80efbcc24dbbdb05817c21fb7, type: 3}
    narration: " \"\uC57D\uC18D\uB41C \uC0DD\uC77C\uC758 \uC544\uCE68. \uC138\uC0C1\uC740
      \uC18C\uB9AC \uC5C6\uC774 \uC8FD\uC5C8\uACE0, \uBAA8\uB4E0 \uC0C9\uCC44\uB294
      \uC99D\uBC1C\uD588\uB2E4.\""
  - image: {fileID: 21300000, guid: df71fbc5c6e818741af922f97580485c, type: 3}
    narration: " \"\uB9C8\uB825\uC774 \uC5C6\uB294 \uB108\uB9CC\uC774 \uC774 \uC7BF\uBE5B
      \uC138\uC0C1\uC744 \uB2E4\uC2DC \uADF8\uB9B4 \uC218 \uC788\uB2E4. \uC6B0\uB9AC\uC758
      \uB9C8\uC9C0\uB9C9 \uBC1C\uBA85\uD488\uC744 \uBC1B\uC544\uB2E4\uC624.\""
  - image: {fileID: 21300000, guid: badfba93591c78d48a060905ade78bf8, type: 3}
    narration: " \"\uB098\uC758 \uC2AC\uD514\uC774 \uD314\uB808\uD2B8\uC758 \uC2EC\uC7A5\uC774
      \uB418\uC5C8\uB2E4. \uC774\uC81C, \uC0AC\uB77C\uC9C4 \uBD80\uBAA8\uB2D8\uC758
      \uD754\uC801\uC744 \uCC3E\uC544 \uC138\uACC4\uB97C \uB2E4\uC2DC \uCE60\uD560
      \uC2DC\uAC04\uC774\uB2E4.\" "
